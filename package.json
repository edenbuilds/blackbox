{
  "name": "@edenbuilds/blackbox",
  "version": "0.2.0",
  "description": "Flight recorder and A/B evaluator for coding agents — reduce Claude Code and Codex transcripts into a queryable event log, and measure whether your agent config actually helps.",
  "type": "module",
  "bin": {
    "blackbox": "bin/blackbox.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node bin/blackbox.mjs selftest && node test/eval-e2e.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "observability",
    "audit-log",
    "transcript",
    "tokens",
    "cost",
    "cli",
    "benchmark",
    "eval",
    "ab-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edenbuilds/blackbox.git"
  },
  "homepage": "https://github.com/edenbuilds/blackbox#readme",
  "bugs": {
    "url": "https://github.com/edenbuilds/blackbox/issues"
  },
  "license": "MIT",
  "author": "Omkar Sonawane (https://github.com/edenbuilds)",
  "publishConfig": {
    "access": "public"
  }
}
